---
import Layout from '../layouts/Layout.astro';
import { gallery } from '../data/site';
---
<Layout title="Fotogalerie | DR zámečnictví a kovovýroba" description="Ukázky pergol, oplocení, schodišť a dalších zakázek z naší dílny.">
  <section class="section section--spaced project-gallery">
    <h1>Realizace</h1>
    <div class="projects-mosaic projects-mosaic--full">
      {gallery.map(photo => (
        <a href={photo.src} aria-label={'Zobrazit fotografii: ' + photo.alt}>
          <img src={photo.src} alt={photo.alt} loading="lazy" />
        </a>
      ))}
    </div>
  </section>
</Layout>
