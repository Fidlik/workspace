---
import Layout from '../layouts/Layout.astro';
import DetailSection from '../components/DetailSection.astro';
import { venkovniNabytekSections } from '../data/site';
---
<Layout title="Venkovní kuchyně a stoly | DR zámečnictví a kovovýroba" description="Venkovní kuchyně, stoly, lavice a podnože na míru pro terasu, zahradu i interiér.">
  <div class="section catalog-stack">
    {venkovniNabytekSections.map((section, index) => (
      <DetailSection section={section} first={index === 0} topHeading={index === 0} fit="contain" />
    ))}
    <p class="catalog-note">Při atypických rozměrech nebo jiném materiálovém řešení připravíme individuální nabídku.</p>
  </div>
</Layout>
