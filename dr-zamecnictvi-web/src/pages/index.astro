---
import Layout from '../layouts/Layout.astro';
import { company, process } from '../data/site';
import { pergolaCalculatorSettings as config } from '../data/pergola.mjs';
import { calculate, currency, defaults } from '../lib/pergola.mjs';
const services = [
  {title:'Pergoly',tag:'Váš nový prostor venku',text:'Ocelová konstrukce, která dá terase tvar. S polykarbonátovou střechou i bez ní.',image:'/images/portfolio/pristresek-1-2023.webp',href:'/pergoly',link:'Navrhnout pergolu'},
  {title:'Brány a oplocení',tag:'Soukromí v čistých liniích',text:'Plot, brána i branka jako jeden celek. Tahokov, kované prvky a kombinace materiálů.',image:'/images/portfolio/plot-tahokov-2023.webp',href:'/oploceni',link:'Prohlédnout oplocení'},
  {title:'Venkovní nábytek',tag:'Místo pro společné chvíle',text:'Kuchyně, stoly a kovové podnože. Praktické kusy přesně pro váš prostor.',image:'/images/products/kuchyne-1544.webp',href:'/venkovni-nabytek',link:'Objevit nábytek'},
];
---
<Layout title="DR zámečnictví | Pergoly a kovovýroba na míru ve Studénce" description="Ocelové pergoly, brány, ploty a nábytek na míru od Daniela Richtera. Rodinná dílna ve Studénce. Spočítejte si orientační cenu pergoly online.">
  <section class="editorial-hero">
    <div class="editorial-hero__photo"><img src="/images/portfolio/pristresek-1-2023.webp" alt="Ocelový přístřešek s polykarbonátovou střechou od DR zámečnictví" width="1024" height="768" fetchpriority="high" /></div>
    <div class="section editorial-hero__inner"><div class="editorial-hero__copy">
      <span class="eyebrow eyebrow--light">RODINNÁ DÍLNA VE STUDÉNCE</span>
      <h1>Poctivá ocel.<br />Čisté linie.<br /><em>Váš prostor.</em></h1>
      <p>Pergoly, brány a kovové prvky, které vašemu domu padnou. Od prvního náčrtu po poslední svár.</p>
      <div class="hero__actions"><a class="button button--accent" href="/pergoly#kalkulacka">Spočítat cenu pergoly</a><a class="text-link text-link--light" href="#realizace">Prohlédnout realizace</a></div>
      <div class="hero__signature"><span class="signature-mark" aria-hidden="true">DR</span><div><strong>Daniel Richter</strong><span>Řemeslo s citem pro detail.</span></div></div>
    </div><div class="hero__caption"><span>Z naší dílny</span><strong>Ocelový přístřešek na míru</strong><span>Vlastní realizace DR zámečnictví</span></div></div>
  </section>
  <div class="trust-strip"><div class="section trust-strip__inner"><span><strong>10+</strong> let zkušeností</span><span>Od návrhu po montáž</span><span>Každý kus na míru</span><span>Osobně s výrobcem</span></div></div>
  <section class="section section--spaced" id="realizace">
    <div class="split-heading"><div><span class="section__eyebrow">CO SPOLU VYTVOŘÍME</span><h2>Dobré řemeslo<br />je vidět v detailu.</h2></div><p>Pevnost oceli, promyšlené proporce a provedení, které ladí s domem. Každá zakázka začíná vaším nápadem.</p></div>
    <div class="editorial-services">{services.map(s => <article class="editorial-service"><a class="editorial-service__image" href={s.href} tabindex="-1" aria-hidden="true"><img src={s.image} alt="" loading="lazy" width="800" height="600" /></a><span class="service-tag">{s.tag}</span><h3><a href={s.href}>{s.title}</a></h3><p>{s.text}</p><a class="text-link" href={s.href}>{s.link}</a></article>)}</div>
    <div class="service-footnote"><span>A co něco atypického?</span><a class="text-link" href="/ostatni">Schodiště, zábradlí a další nápady z kovu</a></div>
  </section>
  <section class="quick-calc-band"><div class="section quick-calc">
    <div><span class="section__eyebrow">NEJDŘÍV PŘEDSTAVA. PAK CENA.</span><h2>Kolik stojí<br /><em>vaše pergola?</em></h2><p>Začněte rozměrem. Krytinu, barvu i montáž si upravíte v kalkulačce a hned uvidíte rozpis ceny.</p><a class="text-link" href="/pergoly">Vše o ocelových pergolách</a></div>
    <div class="quick-calc__panel"><span class="service-tag">Vyberte si rozměr</span><div class="quick-sizes">{config.sizes.map(s => <a href={`/pergoly?size=${s.id}#kalkulacka`}>{s.label}</a>)}</div><div class="quick-calc__price"><div><span>Kompletní varianta 3 × 4 m</span><strong>{currency(calculate(defaults).total)} <small>bez DPH</small></strong></div><a class="button" href="/pergoly#kalkulacka">Upravit a spočítat</a></div><p class="small-note">Orientační cena s krytinou, barvou, zinkováním a montáží. Doprava se nacení zvlášť.</p></div>
  </div></section>
  <section class="section section--spaced workshop-section">
    <div class="workshop-image"><img src="/images/hero.webp" alt="Práce s kovem v dílně DR zámečnictví" loading="lazy" width="1400" height="934" /><div>STUDÉNKA<span>Požárnická 261</span></div></div>
    <div class="workshop-copy"><span class="section__eyebrow">ZA KAŽDÝM SVÁREM JE ČLOVĚK</span><h2>Domluvíte se se mnou.<br /><em>A já to vyrobím.</em></h2><p>Jmenuji se Daniel Richter. V rodinné dílně kousek od nádraží ve Studénce měním nápady v poctivé kovové konstrukce.</p><p>Můžete přijít s výkresem, vzorem i první představou. Společně vybereme materiál, povrch a řešení, které bude dávat smysl právě u vás.</p><a class="text-link" href="/kontakty">Pojďme probrat váš nápad</a><div class="workshop-signature">Daniel Richter<span>Zámečník & výrobce</span></div></div>
  </section>
  <section class="process-band"><div class="section section--spaced"><div class="split-heading"><div><span class="section__eyebrow">OD NÁPADU K HOTOVÉMU KUSU</span><h2>Jasná domluva.<br />Poctivý výsledek.</h2></div><p>Na začátku si řekneme, co potřebujete. Potom vše projdeme krok za krokem až k hotové realizaci.</p></div><div class="process-grid">{process.map(step=><article class="process-step"><span class="process-step__line" aria-hidden="true"></span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></div></section>
  <section class="section section--spaced faq-section"><div><span class="section__eyebrow">JEŠTĚ VÁS MOŽNÁ ZAJÍMÁ</span><h2>Než se pustíme<br />do výroby.</h2><a class="text-link" href="/kontakty">Probrat jiný dotaz</a></div><div class="faq-list"><details><summary>Je cena z kalkulačky konečná?</summary><p>Je orientační a uvedená bez DPH. Vychází z rozměru a zvoleného provedení. Dopravu, kotvení, podklad a případné atypické úpravy společně upřesníme před potvrzením nabídky.</p></details><details><summary>Vyrobíte i jiný rozměr pergoly?</summary><p>Ano. Kalkulačka obsahuje šest základních rozměrů. Pokud potřebujete jiné rozměry nebo atypické řešení, pošlete mi představu a připravím individuální nabídku.</p></details><details><summary>Můžu přijít s vlastním návrhem?</summary><p>Určitě. Stačí náčrt, fotografie, vzor nebo výkres. Projdeme spolu provedení a doporučím vhodný materiál i povrchovou úpravu.</p></details><details><summary>Jak se domluvíme na termínu a montáži?</summary><p>Možnosti montáže i termín probereme podle rozsahu zakázky a místa realizace. Konkrétní postup si potvrdíme před zahájením výroby.</p></details></div></section>
  <section class="closing-cta"><div class="section closing-cta__inner"><div><span class="eyebrow eyebrow--light">MÁTE NÁPAD? POJĎME MU DÁT TVAR.</span><h2>Začněme jedním hovorem.</h2></div><div><a class="closing-cta__phone" href={`tel:+420${company.phones[0].href}`}>{company.phones[0].display}</a><a class="button button--accent" href="/poptavka">Napsat nezávaznou poptávku</a></div></div></section>
</Layout>
