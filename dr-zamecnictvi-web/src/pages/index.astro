---
import Layout from '../layouts/Layout.astro';
import Carousel from '../components/Carousel.astro';
import { company, galleryHighlights, references, services } from '../data/site';
const strengths = [
  { title: 'Férové jednání', path: 'M3 12l4-7 5 2 5-2 4 7-3 2-4-5-3 2a2 2 0 0 1-3-2l4-2M7 14l5 5 2-1 2-1 2-3M3 12l4 2m2 2 2-2m0 4 2-2' },
  { title: 'Návrh a zaměření na místě', path: 'M3 7h18v10H3zM7 7v5m4-5v3m4-3v5m4-5v3' },
  { title: 'Dodržení smluveného termínu', path: 'M4 5h16v15H4zM8 3v4m8-4v4M4 10h16m-11 5 2 2 4-4' },
  { title: 'Poctivá práce do posledního detailu', path: 'M7 4h10l2 5-2 9H7L5 9l2-5Zm1 5h8v4H8zm4 9v3m8-5 2-2m-2 5 2 1' },
];
---
<Layout title="DR zámečnictví | Kovovýroba na míru ve Studénce" description={company.description}>
  <section class="editorial-hero">
    <div class="editorial-hero__photo">
      <img src="/images/pergola-vecer.webp" alt="" width="1500" height="1000" fetchpriority="high" />
    </div>
    <div class="section editorial-hero__inner">
      <div class="editorial-hero__copy">
        <h1>Kovovýroba na míru.<br /><em>Poctivě a na dlouhá léta.</em></h1>
        <p>Vyrábíme podle konkrétního prostoru, požadavků a způsobu využití – pro domácnosti i firmy. Od zaměření a návrhu až po výrobu a montáž.</p>
        <div class="hero__actions">
          <a class="button" href="/poptavka">Nezávazná poptávka</a>
          <a class="button button--ghost" href="#realizace">Prohlédnout realizace</a>
        </div>
      </div>
      <div class="hero__caption">
        <strong>Od návrhu po montáž</strong>
        <p>Zakázku řešíme jako celek. Zaměříme, navrhneme, vyrobíme a namontujeme.</p>
        <small>Ilustrační vizualizace</small>
      </div>
    </div>
  </section>

  <section class="section section--spaced service-section" aria-label="Zakázková kovovýroba">
    <div class="editorial-services">
      {services.map(service => (
        <article class="editorial-service">
          <a class="editorial-service__image" href={service.href} aria-label={'Prohlédnout: ' + service.title}>
            <img src={service.photo.src} alt={service.photo.alt} loading="lazy" width="800" height="600" />
          </a>
          <div class="editorial-service__body">
            <h2><a href={service.href}>{service.title}</a></h2>
            <p>{service.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section section--spaced values-section">
    <h2>Na čem si zakládáme</h2>
    <ul class="values-grid">
      {strengths.map(({title, path}) => (
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={path} /></svg>
          <h3>{title}</h3>
        </li>
      ))}
    </ul>
  </section>

  <section class="references-section">
    <div class="section section--spaced">
      <h2>Co říkají naši zákazníci</h2>
      <Carousel label="Zkušenosti zákazníků" count={references.length} kind="references">
        {references.map(reference => (
          <figure class="reference-card">
            <span class="reference-card__mark" aria-hidden="true">“</span>
            <blockquote><p>{reference.quote}</p></blockquote>
            <p>{reference.description}</p>
            <figcaption>{reference.author}</figcaption>
          </figure>
        ))}
      </Carousel>
    </div>
  </section>

  <section class="section section--spaced" id="realizace">
    <h2>Ukázka realizací</h2>
    <div class="projects-mosaic">
      {galleryHighlights.map(photo => (
        <a href={photo.src} aria-label={'Zobrazit fotografii: ' + photo.alt}>
          <img src={photo.src} alt={photo.alt} loading="lazy" />
        </a>
      ))}
    </div>
    <div class="projects-actions"><a class="button button--ghost" href="/fotogalerie">Zobrazit všechny realizace</a></div>
  </section>

  <section class="closing-cta">
    <div class="section closing-cta__inner">
      <div><h2>Proberme vaši zakázku</h2><p>Pošlete nám rozměry, místo realizace a svoji představu.</p></div>
      <div><a class="closing-cta__phone" href={'tel:+420' + company.phones[0].href}>{company.phones[0].display}</a><a class="button" href="/poptavka">Nezávazná poptávka</a></div>
    </div>
  </section>
</Layout>
