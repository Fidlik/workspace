---
import Layout from '../layouts/Layout.astro';
import DetailSection from '../components/DetailSection.astro';
import { ostatniSections } from '../data/site';
---
<Layout title="Další realizace | DR zámečnictví a kovovýroba" description="Zakázková výroba schodišť, zábradlí, uměleckých objektů a atypických výrobků z kovu.">
  <div class="section catalog-stack">
    {ostatniSections.map((section, index) => (
      <DetailSection section={section} first={index === 0} topHeading={index === 0} />
    ))}
  </div>
</Layout>
