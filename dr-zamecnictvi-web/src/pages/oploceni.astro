---
import Layout from '../layouts/Layout.astro';
import DetailSection from '../components/DetailSection.astro';
import { oploceniSections } from '../data/site';
---
<Layout title="Brány a oplocení | DR zámečnictví a kovovýroba" description="Ploty a vjezdové brány na míru od návrhu po montáž.">
  <div class="section catalog-stack">
    {oploceniSections.map((section, index) => (
      <DetailSection section={section} first={index === 0} topHeading={index === 0} />
    ))}
  </div>
</Layout>
