---
import { pergolaCalculatorSettings as config } from '../data/pergola.mjs';
import { calculate, defaults, currency } from '../lib/pergola.mjs';
const initial = calculate(defaults);
const groups = [
 {name:'roofing',title:'Střešní krytina',options:[['polycarbonate','Polykarbonát'],['none','Bez krytiny']]},
 {name:'zinc',title:'Ochrana konstrukce',options:[['included','Žárové zinkování'],['none','Bez zinkování']]},
 {name:'assembly',title:'Montáž',options:[['pro','Montáž od nás'],['self','Vlastní montáž']]},
 {name:'delivery',title:'Doprava',options:[['pickup','Osobní vyzvednutí'],['delivery','Doprava k vám']]},
];
const rows=[['structure','Ocelová konstrukce'],['roofing','Střešní krytina'],['color','Barva · komaxit'],['zinc','Žárové zinkování'],['assembly','Montáž']];
---
<div class="pergola-calculator" data-pergola-calculator-root>
  <div class="pergola-calculator__layout">
    <div class="pergola-calculator__controls">
      <noscript><p class="no-js-note">Pro přepočítání ceny zapněte JavaScript. Zobrazená cena platí pro výchozí variantu 3 × 4 m. Individuální nabídku získáte telefonicky na 724 556 144.</p></noscript>
      <fieldset class="calc-group"><legend>Rozměr pergoly <span class="calc-group__hint">Dva půdorysné rozměry v metrech</span></legend><div class="calc-size-grid">{config.sizes.map(size => <label class="calc-radio"><input type="radio" name="size" value={size.id} checked={size.id===defaults.size} /><span>{size.label}</span></label>)}</div></fieldset>
      <fieldset class="calc-group"><legend>Barva konstrukce <span class="calc-group__hint">Komaxit je zahrnutý ve všech variantách</span></legend><div class="calc-color-grid">{config.colors.map(color => <label class="calc-color"><input type="radio" name="color" value={color.id} checked={color.id===defaults.color} /><span><i style={`--swatch:${color.swatch}`} aria-hidden="true"></i><span>{color.label}<small>{color.ral}</small></span></span></label>)}</div></fieldset>
      {groups.map(group => <fieldset class="calc-group"><legend>{group.title}</legend><div class="calc-segmented">{group.options.map(([value,label])=><label class="calc-option"><input type="radio" name={group.name} value={value} checked={defaults[group.name]===value} /><span>{label}</span></label>)}</div></fieldset>)}
    </div>
    <div class="pergola-calculator__aside">
      <figure class="pergola-preview" data-pergola-preview hidden>
        <div class="pergola-preview__scene">
          <img src="/images/pergola-terrace.webp" alt="" width="1080" height="720" loading="lazy" decoding="async" />
          <canvas width="1080" height="720" role="img" aria-label="Ilustrační vizualizace pergoly" data-pergola-canvas></canvas>
          <span class="pergola-preview__label">Ilustrační vizualizace</span>
        </div>
        <figcaption class="pergola-preview__caption">
          <strong data-preview-size>{initial.size.label}</strong>
          <span><span data-preview-color>{initial.color.ral}</span> · <span data-preview-roof>Polykarbonát</span></span>
        </figcaption>
      </figure>
      <aside class="pergola-summary" aria-label="Shrnutí vaší pergoly">
      <div class="pergola-summary__rows">
        <span class="pergola-summary__eyebrow">Vaše orientační cena</span>
        <strong class="pergola-summary__total" data-total aria-live="polite" aria-atomic="true">{currency(initial.total)}</strong>
        <span class="pergola-summary__tax">bez DPH · doprava se řeší samostatně</span>
        {rows.map(([key,label])=><div class="pergola-summary__row"><span>{label}</span><strong data-row={key}>{currency(initial.rows[key])}</strong></div>)}
        <div class="pergola-summary__row pergola-summary__row--delivery"><span>Doprava</span><strong data-delivery-price>Vyzvednutí zdarma</strong></div>
      </div>
      <p class="pergola-summary__note" data-delivery-note>Osobní vyzvednutí bez dalšího příplatku.</p>
      <a class="button" data-inquiry-link href="/poptavka?produkt=pergola-kalkulace">Poptat tuto pergolu</a>
      <button class="calc-share" type="button" data-share>Zkopírovat konfiguraci</button><span class="calc-share-status" data-share-status role="status"></span>
      <p class="pergola-summary__note">Kalkulace je nezávazná. Aktuální cenu a rozsah dodávky potvrdíme po upřesnění podkladu, kotvení a místa realizace.</p>
      </aside>
    </div>
  </div>
</div>
<script>
  import { calculate, currency, defaults, parseSelection, selectionParams } from '../lib/pergola.mjs';
  import { pergolaCalculatorSettings as config } from '../data/pergola.mjs';
  import { renderPergola } from '../lib/pergola-preview.mjs';
  const root = document.querySelector<HTMLElement>('[data-pergola-calculator-root]');
  if (root) {
    const preview = root.querySelector<HTMLElement>('[data-pergola-preview]')!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-pergola-canvas]')!;
    let lastPreview = '';
    const updatePreview = (result: ReturnType<typeof calculate>, hasRoof: boolean) => {
      const key = `${result.size.id}:${result.color.id}:${hasRoof}`;
      if (key === lastPreview || !canvas.getContext('2d')) return;
      renderPergola(canvas, { size: result.size.id, color: result.color.swatch, hasRoof });
      lastPreview = key;
      const roof = hasRoof ? 'Polykarbonát' : 'Bez krytiny';
      preview.querySelector('[data-preview-size]')!.textContent = result.size.label;
      preview.querySelector('[data-preview-color]')!.textContent = result.color.ral;
      preview.querySelector('[data-preview-roof]')!.textContent = roof;
      canvas.setAttribute('aria-label', `Ilustrační vizualizace pergoly ${result.size.label}, ${result.color.label}, ${roof.toLowerCase()}`);
      preview.hidden = false;
    };
    const initial = parseSelection(new URLSearchParams(location.search));
    for (const key of Object.keys(defaults)) for (const input of root.querySelectorAll<HTMLInputElement>(`input[name="${key}"]`)) input.checked=input.value===initial[key];
    const read = () => Object.fromEntries(Object.keys(defaults).map(key=>[key,root.querySelector<HTMLInputElement>(`input[name="${key}"]:checked`)?.value??defaults[key]]));
    const render = () => {
      const selection=read(), result=calculate(selection);
      root.querySelector('[data-total]')!.textContent=currency(result.total);
      for (const [key,value] of Object.entries(result.rows)) root.querySelector(`[data-row="${key}"]`)!.textContent=currency(value);
      root.querySelector('[data-delivery-price]')!.textContent=selection.delivery==='delivery'?'Dle adresy, mimo součet':'Vyzvednutí zdarma';
      root.querySelector('[data-delivery-note]')!.textContent=selection.delivery==='delivery'?config.deliveryNote:'Osobní vyzvednutí bez dalšího příplatku.';
      const params=selectionParams(selection);
      const url=new URL(location.href);for(const [key,value] of params)url.searchParams.set(key,value);
      history.replaceState(null,'',url);
      params.set('produkt','pergola-kalkulace');
      root.querySelector<HTMLAnchorElement>('[data-inquiry-link]')!.href=`/poptavka?${params}`;
      updatePreview(result, selection.roofing === 'polycarbonate');
      root.querySelector('[data-share-status]')!.textContent='';
    };
    root.addEventListener('change',render);render();
    root.querySelector('[data-share]')?.addEventListener('click',async()=>{const status=root.querySelector('[data-share-status]')!;try{await navigator.clipboard.writeText(location.href);status.textContent='Odkaz na konfiguraci je zkopírovaný.';}catch{status.textContent='Konfigurace je uložená v odkazu v adresním řádku.';}});
  }
</script>
