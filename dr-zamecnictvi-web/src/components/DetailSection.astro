---
import PhotoCarousel from './PhotoCarousel.astro';
import type { SectionBlock } from '../data/site';

type Props = {section: SectionBlock; first?: boolean; topHeading?: boolean; fit?: 'contain' | 'cover'};
const {section, first = false, topHeading = false, fit = 'cover'} = Astro.props;
const Heading = topHeading ? 'h1' : 'h2';
---
<section class="catalog-row" id={section.id}>
  <div class="catalog-row__copy">
    <Heading>{section.title}</Heading>
    {section.intro && <p class="catalog-row__lead">{section.intro}</p>}
    <p>{section.text}</p>
    {section.price && <p class="catalog-row__price">{section.price}</p>}
    <a class="button" href={section.ctaHref}>Nezávazná poptávka</a>
  </div>
  <PhotoCarousel photos={section.photos} label={section.title + ' – fotografie'} eager={first} fit={fit} />
</section>
